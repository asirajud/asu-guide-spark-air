# ASU AIR gateway — install.sh fills RC_OPENAI_API_KEY in .env.local.
# Get a key: ASU VPN -> voyager.rc.asu.edu -> AI LLM tab -> Create Key
RC_OPENAI_API_KEY=

# Optional AIR overrides
# AIR_BASE_URL=https://openai.rc.asu.edu/v1
# AIR_ASR_MODEL=qwen3-asr-1p7b

# HeatRoute basemap. Unset = the SVG pilot map. Any MapLibre style URL works;
# for MapTiler, create a key at https://cloud.maptiler.com/account/keys/
# NEXT_PUBLIC_HEATROUTE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY

# This app's own origin. Must match the redirect_uri registered for
# "asu-guide-demo" in asu-sso/clients.json, or sign-in is rejected.
APP_URL=http://localhost:3000

# Sibling services
SSO_ISSUER=http://localhost:4000
TOOLS_API_URL=http://127.0.0.1:5000

# Demo SSO client credentials — fake, committed on purpose (see asu-sso/clients.json)
SSO_CLIENT_ID=asu-guide-demo
SSO_CLIENT_SECRET=demo-secret-not-a-real-credential

# Cookie signing key for the local session. Change for anything non-demo.
SESSION_SECRET=demo-session-secret-not-a-real-credential

# Local SQLite database
DATABASE_URL=local.db
